rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function privateAccount(userId) {
      return ('accountPrivacy' in get(
        /databases/$(database)/documents/users/$(userId)
      ).data) && get(
        /databases/$(database)/documents/users/$(userId)
      ).data.accountPrivacy == 'private';
    }

    function activeFollower(userId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/followRelationships/$(userId)/followers/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/followRelationships/$(userId)/followers/$(request.auth.uid)
        ).data.status == 'active';
    }

    // Public social graphs are readable by signed-in users. Private social
    // graphs are readable by their owner and active followers only.
    function canViewSocialGraph(userId) {
      return ownsUser(userId) || !privateAccount(userId) || activeFollower(userId);
    }

    match /users/{userId} {
      allow create: if ownsUser(userId)
        && request.resource.data.keys().hasOnly([
          'displayName',
          'handle',
          'handleNormalized',
          'accountPrivacy',
          'profileImage',
          'createdAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 50
        && request.resource.data.handle is string
        && request.resource.data.handleNormalized is string
        && request.resource.data.accountPrivacy in ['public', 'private']
        && request.resource.data.handleNormalized.matches('^[a-z0-9_]{3,20}$')
        && getAfter(
          /databases/$(database)/documents/handles/$(request.resource.data.handleNormalized)
        ).data.userId == userId;

      allow read: if signedIn();

      allow update: if ownsUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'profileImage', 'accountPrivacy'])
        && (!('accountPrivacy' in request.resource.data)
          || request.resource.data.accountPrivacy in ['public', 'private']);

      allow delete: if false;
    }

    match /userSettings/{userId} {
      allow read: if ownsUser(userId);

      allow create, update: if ownsUser(userId)
        && request.resource.data.keys().hasOnly([
          'defaultReviewVisibility',
          'defaultMediaFilter',
          'defaultSort',
          'updatedAt'
        ])
        && request.resource.data.defaultReviewVisibility in [
          'public', 'followers', 'private'
        ]
        && (!('defaultMediaFilter' in request.resource.data)
          || request.resource.data.defaultMediaFilter in ['all', 'movie', 'tv'])
        && (!('defaultSort' in request.resource.data)
          || request.resource.data.defaultSort in [
            'newest', 'oldest', 'highestRated', 'lowestRated'
          ])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /handles/{handleNormalized} {
      allow read: if signedIn();

      allow create: if signedIn()
        && handleNormalized.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly([
          'userId', 'handle', 'handleNormalized'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.handle is string
        && request.resource.data.handleNormalized == handleNormalized;

      allow update, delete: if false;
    }

    match /reviews/{reviewId} {
      function validReviewTitle(value) {
        // Rules can reliably require a non-empty string, while the client
        // performs friendlier trimmed/non-whitespace validation.
        return value is string && value.size() > 0 && value.size() <= 200;
      }

      function validRating(value) {
        return value is number
          && value is int
          && value >= 1
          && value <= 5;
      }

      function validReviewText(value) {
        // Firestore Rules has no safe general-purpose string trim operation.
        // Service/client validation rejects whitespace-only text before write.
        return value is string && value.size() > 0 && value.size() <= 3000;
      }

      function validVisibility(value) {
        return value in ['public', 'followers', 'private'];
      }

      function validMediaTarget(movie) {
        return (movie.mediaType == 'movie'
            && movie.reviewTargetType == 'movie')
          || (movie.mediaType == 'tv'
            && movie.reviewTargetType == 'series');
      }

      function validReleaseYear(value) {
        return value == null
          || (value is int && value >= 1880 && value <= 2200);
      }

      function validPosterUrl(value) {
        return value == null || (value is string && value.size() <= 1000);
      }

      function validGenre(value) {
        return value is string && value.size() <= 50;
      }

      // Rules cannot iterate a list. The schema cap is 20, so each possible
      // list position is checked explicitly after its size is bounded.
      function validGenres(genres) {
        return genres is list
          && genres.size() <= 20
          && (genres.size() < 1 || validGenre(genres[0]))
          && (genres.size() < 2 || validGenre(genres[1]))
          && (genres.size() < 3 || validGenre(genres[2]))
          && (genres.size() < 4 || validGenre(genres[3]))
          && (genres.size() < 5 || validGenre(genres[4]))
          && (genres.size() < 6 || validGenre(genres[5]))
          && (genres.size() < 7 || validGenre(genres[6]))
          && (genres.size() < 8 || validGenre(genres[7]))
          && (genres.size() < 9 || validGenre(genres[8]))
          && (genres.size() < 10 || validGenre(genres[9]))
          && (genres.size() < 11 || validGenre(genres[10]))
          && (genres.size() < 12 || validGenre(genres[11]))
          && (genres.size() < 13 || validGenre(genres[12]))
          && (genres.size() < 14 || validGenre(genres[13]))
          && (genres.size() < 15 || validGenre(genres[14]))
          && (genres.size() < 16 || validGenre(genres[15]))
          && (genres.size() < 17 || validGenre(genres[16]))
          && (genres.size() < 18 || validGenre(genres[17]))
          && (genres.size() < 19 || validGenre(genres[18]))
          && (genres.size() < 20 || validGenre(genres[19]));
      }

      function validRetention(retention) {
        return retention is map
          && retention.keys().hasOnly([
            'fetchedAt', 'refreshAfter', 'expiresAt'
          ])
          && retention.keys().hasAll([
            'fetchedAt', 'refreshAfter', 'expiresAt'
          ])
          && retention.fetchedAt is timestamp
          && retention.refreshAfter is timestamp
          && retention.expiresAt is timestamp
          && retention.fetchedAt < retention.refreshAfter
          && retention.refreshAfter < retention.expiresAt;
      }

      function validCommonMovieFields(movie) {
        return movie is map
          && validMediaTarget(movie)
          && validReviewTitle(movie.title)
          && validReleaseYear(movie.releaseYear)
          && validGenres(movie.genres)
          && validPosterUrl(movie.posterUrl);
      }

      function validManualMovie(movie) {
        return validCommonMovieFields(movie)
          && movie.keys().hasOnly([
            'mediaType', 'reviewTargetType', 'matchStatus', 'catalogId',
            'title', 'releaseYear', 'genres', 'posterUrl'
          ])
          && movie.keys().hasAll([
            'mediaType', 'reviewTargetType', 'matchStatus', 'catalogId',
            'title', 'releaseYear', 'genres', 'posterUrl'
          ])
          && movie.matchStatus == 'manual'
          && movie.catalogId == null;
      }

      function validMatchedMovie(movie) {
        return validCommonMovieFields(movie)
          && movie.keys().hasOnly([
            'mediaType', 'reviewTargetType', 'matchStatus', 'catalogId',
            'title', 'releaseYear', 'genres', 'posterUrl',
            'catalogDataRetention'
          ])
          && movie.keys().hasAll([
            'mediaType', 'reviewTargetType', 'matchStatus', 'catalogId',
            'title', 'releaseYear', 'genres', 'posterUrl',
            'catalogDataRetention'
          ])
          && movie.matchStatus == 'matched'
          && movie.catalogId is string
          && movie.catalogId.size() > 0
          && movie.catalogId.size() <= 200
          && validRetention(movie.catalogDataRetention);
      }

      function validMovie(movie) {
        return validManualMovie(movie) || validMatchedMovie(movie);
      }

      function validUpdatedAt(data) {
        return !('updatedAt' in data)
          || (data.updatedAt is timestamp && data.updatedAt >= data.createdAt);
      }

      function validReview(data) {
        return data.keys().hasOnly([
            'userId', 'movieTitle', 'movie', 'reviewText', 'rating',
            'visibility', 'createdAt', 'updatedAt', 'spoilerWarning'
          ])
          && data.keys().hasAll([
            'userId', 'movieTitle', 'movie', 'reviewText', 'rating',
            'visibility', 'createdAt', 'spoilerWarning'
          ])
          && data.userId is string
          && validReviewTitle(data.movieTitle)
          && validMovie(data.movie)
          && validReviewText(data.reviewText)
          && validRating(data.rating)
          && validVisibility(data.visibility)
          && data.spoilerWarning is bool
          && data.createdAt is timestamp
          && validUpdatedAt(data);
      }

      function preservesMatchedIdentity() {
        return resource.data.movie.matchStatus != 'matched'
          || (request.resource.data.movie.matchStatus == 'matched'
            && request.resource.data.movie.catalogId
              == resource.data.movie.catalogId
            && request.resource.data.movie.mediaType
              == resource.data.movie.mediaType
            && request.resource.data.movie.reviewTargetType
              == resource.data.movie.reviewTargetType);
      }

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && validReview(request.resource.data);

      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid
        || resource.data.visibility == 'public'
        || (resource.data.visibility == 'followers'
          && activeFollower(resource.data.userId))
      );

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && validReview(request.resource.data)
        && preservesMatchedIdentity();

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // This collection-group rule authorizes a user's Following list. It
    // intentionally exposes active relationships only, never pending requests.
    match /{path=**}/followers/{followerId} {
      allow list: if signedIn()
        && resource.data.status == 'active'
        && canViewSocialGraph(resource.data.followerId);
    }

    match /followRelationships/{followedUserId}/followers/{followerId} {
      // Participants can inspect their own relationship, including a pending
      // request. Lists use the narrower rules below.
      allow get: if signedIn()
        && (request.auth.uid == followerId || request.auth.uid == followedUserId);

      // Followers list: public accounts are visible to everyone signed in;
      // private accounts are visible to the owner and active followers. Owners
      // can also list their pending requests.
      allow list: if signedIn() && (
        ownsUser(followedUserId)
        || (resource.data.status == 'active'
          && canViewSocialGraph(followedUserId))
      );

      // Relationship mutations and profile counters are maintained only by
      // the trusted Admin SDK social API. Admin writes bypass these rules.
      allow create, update, delete: if false;
    }
  }
}
